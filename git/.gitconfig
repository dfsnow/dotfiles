[user]
    name = Dan Snow
    email = dan@sno.ws
    signingkey = 7E773BB13A204904!

[commit]
    gpgsign = true

[tag]
    gpgSign = true
    forceSignAnnotated = true

[gpg]
    program = gpg

[core]
    pager = command -v hunk >/dev/null 2>&1 && hunk pager || command -v less >/dev/null 2>&1 && less || cat
    autocrlf = false

[diff]
    tool = hunk

[difftool]
    prompt = false

[difftool "hunk"]
    cmd = hunk difftool "$LOCAL" "$REMOTE" "$MERGED"

[init]
    defaultBranch = main

[push]
    default = current
    autoSetupRemote = true

[color]
    ui = auto

[credential]
    helper = cache

[diff "lfs"]
    textconv = cat

[merge]
    conflictStyle = zdiff3

[alias]
    a = add
    r = reset
    aa = add .
    ac = !git add -A && git commit -m

    c = commit
    cm = commit -m
    ca = commit --amend --verbose

    d = diff
    ds = diff --stat

    s = status -s -b
    co = checkout
    n = checkout -b

    ss = stash
    sl = stash list
    sd = stash drop
    sp = stash pop
    sc = stash clear

    pu = push
    pl = !git pull --rebase --prune && git submodule update --init --recursive

    f = fetch --prune --verbose
    cl = clone
    m = merge

    # Get ID and GPG key
    w = "!echo $(git var GIT_COMMITTER_IDENT) $(git config --get user.signingkey)"
    who = w

    # Show pretty logs
    l = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
    lg = "!git log --graph --pretty=oneline --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all"

    b = branch
    bl = branch -a
    # Delete local branches whose upstream is gone
    bd = "!git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" { print $1 }' | xargs -I{} git branch -D {}"

    # Fuzzy find branches and tags
    bf = "!git checkout $(( git branch -a --color=never --format='%(refname:short)' --sort=committerdate & git tag -l ) | grep -v '^head' | fzf --height 40% --reverse --ansi --multi --tac --preview 'git log --oneline --decorate --color=always -200 {}' | sed 's#^remotes/[^/]*/##' | sed 's#^origin/##')"

    # List aliases
    la = "!git config -l | grep alias | cut -c 7-"

    # How many commits have been made by different authors
    lw = shortlog -n -s --no-merges
    lc = "!git ls-files | while read f; do git blame -w --line-porcelain -- \"$f\" | grep -I '^author-mail '; done | sed 's/@.*//g'| sed 's/<//g' | sort -f | uniq -ic | sort -nr"
    lh = "!git log --numstat --pretty=\"%ae %H\" | sed 's/@.*//g' | awk '{ if (NF == 1){ name = $1}; if(NF == 3) {plus[name] += $1; minus[name] += $2}} END { for (name in plus) {print name\": +\"plus[name]\" -\"minus[name]}}' | sort -k2 -gr"
